# Copy to .env and fill in. See docs/PRD.md (Security Requirements) for what each key is for.

# Postgres connection string. Local dev default assumes a Homebrew/local Postgres
# with trust auth and a database named vriddhi_dev already created:
#   createdb vriddhi_dev
DATABASE_URL="postgresql://USER@localhost:5432/vriddhi_dev?schema=public"

# Anthropic API key — required from Phase 8 (AI explanation layer) onward.
ANTHROPIC_API_KEY=

# Razorpay TEST MODE credentials only — required from Phase 12 onward.
# Get these from the Razorpay Dashboard (Test Mode toggle) — never use live keys here.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Auth.js session secret — required from Phase 4 auth wiring onward.
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app (used for auth callbacks and webhook URLs).
APP_URL="http://localhost:3000"

# When true, the app can run fully on seeded data without any external API keys.
DEMO_MODE="true"
